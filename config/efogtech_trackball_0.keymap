#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/adaptive_feedback.h>
#include <dt-bindings/zmk/bistable_behavior.h>
#include <dt-bindings/zmk/p2sm.h>
#include <mouse-gesture.dtsi>
#include <dt-bindings/zmk/mouse-gesture.h>

#ifndef LAYER_DEFAULT
#define LAYER_DEFAULT      0
#define LAYER_EXTRAS       1
#define LAYER_DEVICE       2
#define LAYER_SCROLL       3
#define LAYER_SNIPE        4
#define LAYER_USER         5
#endif

/* Gesture Configuration */
&zip_mouse_gesture {
    stroke-size = <180>;
    idle-timeout-ms = <150>;
    suppress-movement;

    /* South -> Copy (Ctrl + C) */
    gesture_copy {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LC(C)>;
    };

    /* North -> Paste (Ctrl + Shift + V) */
    gesture_paste {
        pattern = <GESTURE_UP>;
        bindings = <&kp LC(LS(V))>;
    };

    /* Left -> Previous Workspace (Ctrl + Meta + Left) */
    gesture_prev_workspace {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LC(LG(LEFT))>;
    };

    /* Right -> Next Workspace (Ctrl + Meta + Right) */
    gesture_next_workspace {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LC(LG(RIGHT))>;
    };

    /* South-East (Down then Right) -> Play/Pause */
    gesture_play_pause {
        pattern = <GESTURE_DOWN GESTURE_RIGHT>;
        bindings = <&kp C_PP>;
    };
};

/ {
    behaviors {
        back_gesture: back_gesture {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <0>;
            bindings = <&mouse_gesture>, <&mkp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default";
            DECLARE_ENCODERS;
            bindings = <
                // buttons
                &ltmkp LAYER_SNIPE ENTER  &ltmkp LAYER_SCROLL ESC
                &mkp MCLK                 &cdch LAYER_SCROLL 0
                &mkp LCLK                 &mkp RCLK
                &back_gesture 0 MB4       &ltm LAYER_DEVICE MB5

                // rotary encoders
                &kp C_VOL_UP              &kp LC(TAB)
                &kp C_VOL_DN              &kp LC(LS(TAB))
            >;
        };

        layer1 {
            display-name = "Extras";
            DECLARE_ENCODERS;
            bindings = <
                &bst_copy      &bst_paste
                &bst_cut       &bst_undo
                &bst_undo      &bst_copy
                &trans         &bst_paste

                &kp C_VOL_UP   &kp LC(TAB)
                &kp C_VOL_DN   &kp LC(LS(TAB))
            >;
        };

        layer2 {
            display-name = "Device";
            DECLARE_ENCODERS;
            bindings = <
                &mui_or_dgl          &bt BT_CLR
                &bst_tog ZBS_TOG     &bt BT_NXT
                &af_toggle AF_TOG    &bt BT_PRV
                &studio_unlock       &trans

                &kp C_VOL_UP         &kp LC(TAB)
                &kp C_VOL_DN         &kp LC(LS(TAB))
            >;
        };

        layer3 {
            display-name = "Scroll";
            DECLARE_ENCODERS;
            bindings = <
                &trans              &trans
                &trans              &scrlsens P2SM_INC 1
                &rrl 1              &scrlsens P2SM_DEC 1
                &sens P2SM_DEC 1    &sens P2SM_INC 1

                &sens P2SM_DEC 1    &scrlsens P2SM_INC 1
                &sens P2SM_INC 1    &scrlsens P2SM_DEC 1
            >;
        };

        layer4 {
            display-name = "Snipe";
            DECLARE_ENCODERS;
            bindings = <
                &trans           &soft_off
                &trans           &trans
                &trans           &trans
                &trans           &trans

                &kp LEFT         &kp RIGHT
                &kp RIGHT        &kp LEFT
            >;
        };

        layer5 {
            display-name = "User";
            DECLARE_ENCODERS;
            bindings = <
                &trans        &trans
                &trans        &trans
                &trans        &trans
                &trans        &trans

                &kp C_VOL_UP  &kp LC(TAB)
                &kp C_VOL_DN  &kp LC(LS(TAB))
            >;
        };
    };

    trackball {
        input-processors = <&zip_rotate_pointer>,
                           <&zip_mouse_gesture>,
                           <&zip_bistable_twist_scaler>,
                           <&zip_pointer_accel>, <&zip_scroll_accel>,
                           <&esb_ip>, <&zip_ble_report_rate_limit>;

        scroll {
            layers = <LAYER_SCROLL>;
            input-processors = <&zip_bistable_scroll_xy_scaler>, <&zip_axis_clamper>,
                               <&zip_xy_to_scroll_mapper>, <&zip_scroll_transform INPUT_TRANSFORM_Y_INVERT>,
                               <&zip_dragscroll_accel>, <&zip_rotate_scroll>,
                               <&esb_ip>, <&zip_ble_report_rate_limit>;
        };

        snipe {
            layers = <LAYER_SNIPE>;
            input-processors = <&zip_bistable_snipe_scaler>, <&zip_rotate_pointer>,
                               <&esb_ip>, <&zip_ble_report_rate_limit>;
        };
    };
};
